{
  "manifest_version": 3,
  "name": "Send to Figma (Page to Figma)",
  "version": "0.1.0",
  "description": "One click sends the page you are looking at to the Page to Figma plugin.",
  "action": {
    "default_title": "Send this page to Figma",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+F", "mac": "Alt+Shift+F" }, "description": "Send this page to Figma" }
  }
}
